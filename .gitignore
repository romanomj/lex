# Kubernetes Dynamic Cache (live cluster data, never commit)
raw-nodes*.json
raw-pods*.json
cluster_state*.json

# DVR recordings database
lex_dvr.db
lex_dvr.db-*

# Python bytecodes
__pycache__/
*.py[cod]
*$py.class

# OS & Editor configurations
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local data directory (cluster dumps, compiled states, DVR database)
data/
.tmp-*.json

# Your organization's brand (logo, name, colors): user-supplied, never committed. Start from brand.example/.
brand/

# Archipelago tuning (F-36): user-supplied, never committed. Start from archipelago.example.json.
archipelago.json

# Credentials and cluster access: never committed
.env
.env.*
*.pem
*.key
*.p12
*.pfx
kubeconfig*
*.kubeconfig
